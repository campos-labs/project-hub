    "    silver_service_operations,\n",
    "    gold_source_trace,\n",
    "    gold_simulation_detail,\n",
    "    gold_simulation_summary,\n",
    "]:\n",
    "    if \"simulation_run_id\" not in df.columns:\n",
    "        df.insert(0, \"simulation_run_id\", simulation_run_id)\n",
    "\n",
    "run_manifest = pd.DataFrame([{\n",
    "    \"simulation_run_id\": simulation_run_id,\n",
    "    \"status\": \"COMPLETED\",\n",
    "    \"created_at_utc\": run_created_at_utc,\n",
    "    \"fixture_id\": fixture[\"fixture\"][\"id\"],\n",
    "    \"fixture_version\": fixture[\"fixture\"][\"version\"],\n",
    "    \"company_id\": fixture[\"fixture\"][\"company_id\"],\n",
    "    \"base_period\": fixture[\"fixture\"][\"base_period\"],\n",
    "    \"input_manifest_hash\": input_manifest_hash,\n",
    "    \"scenario_parameters_hash\": scenario_parameters_hash,\n",
    "    \"rtc_mapping_sha256\": rtc_sha,\n",
    "    \"sped_layout_sha256\": layout_sha,\n",
    "    \"efd_sha256\": efd_sha,\n",
    "    \"parser_version\": POC_CODE_VERSION,\n",
    "    \"calculation_engine_version\": POC_CODE_VERSION,\n",
    "    \"code_commit\": run_signature_payload[\"code_commit\"],\n",
    "    \"forced_recompute\": bool(FORCE_RECOMPUTE),\n",
    "    \"duckdb_parity_status\": duckdb_parity_status,\n",
    "    \"silver_operation_rows\": len(silver_service_operations),\n",
    "    \"gold_detail_rows\": len(gold_simulation_detail),\n",
    "    \"gold_summary_rows\": len(gold_simulation_summary),\n",
    "}])\n",
    "\n",
    "def write_local_outputs() -> None:\n",
    "    LOCAL_OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "    outputs = {\n",
    "        \"bronze_file_manifest.csv\": bronze_file_manifest,\n",
    "        \"silver_service_operations.csv\": silver_service_operations,\n",
    "        \"gold_source_trace.csv\": gold_source_trace,\n",
    "        \"gold_simulation_detail.csv\": gold_simulation_detail,\n",
    "        \"gold_simulation_summary.csv\": gold_simulation_summary,\n",
    "        \"simulation_run.csv\": run_manifest,\n",
    "    }\n",
    "    for name, df in outputs.items():\n",
    "        df.to_csv(LOCAL_OUTPUT_DIR / name, index=False, encoding=\"utf-8\")\n",
    "    print(f\"local_outputs={LOCAL_OUTPUT_DIR}\")\n",
    "\n",
    "if not IN_FABRIC:\n",
    "    write_local_outputs()\n",
    "\n",
    "def clean_records_for_spark(df: pd.DataFrame) -> list[dict[str, Any]]:\n",
    "    records = []\n",
    "    for record in df.to_dict(\"records\"):\n",
    "        clean = {}\n",
    "        for key, value in record.items():\n",
    "            if value is None:\n",
    "                clean[key] = None\n",
    "            elif isinstance(value, Decimal):\n",
    "                # Spark infere string e o cast monetário/rate é feito depois.\n",
    "                clean[key] = str(value)\n",
    "            elif isinstance(value, float) and pd.isna(value):\n",
    "                clean[key] = None\n",
    "            elif isinstance(value, pd.Timestamp):\n",
    "                clean[key] = value.to_pydatetime()\n",
    "            else:\n",
    "                clean[key] = value\n",
    "        records.append(clean)\n",
    "    return records\n",
    "\n",
    "FABRIC_TABLES = {\n",
    "    \"bronze.file_manifest\": bronze_file_manifest,\n",
    "    \"bronze.efd_lines\": bronze_efd_lines,\n",
    "    \"silver.efd_documents\": silver_efd_documents,\n",
    "    \"silver.efd_items\": silver_efd_items,\n",
    "    \"silver.nfse_documents\": silver_nfse_documents,\n",
    "    \"silver.nfse_events\": silver_nfse_events,\n",
    "    \"silver.service_operations\": silver_service_operations,\n",
    "    \"gold.source_trace\": gold_source_trace,\n",
    "    \"gold.simulation_detail\": gold_simulation_detail,\n",
    "    \"gold.simulation_summary\": gold_simulation_summary,\n",
    "}\n",
    "\n",
    "# Colunas que devem chegar ao Delta como DECIMAL, não como double.\n",
    "DECIMAL_COLUMNS = {\n",
    "    \"silver.efd_documents\": [\n",
    "        \"VL_DOC\", \"VL_DESC\", \"VL_BC_PIS\", \"VL_PIS\",\n",
    "        \"VL_BC_COFINS\", \"VL_COFINS\", \"VL_PIS_RET\", \"VL_COFINS_RET\", \"VL_ISS\",\n",
    "    ],\n",
    "    \"silver.efd_items\": [\n",
    "        \"VL_ITEM\", \"VL_DESC\", \"VL_BC_PIS\", \"ALIQ_PIS\", \"VL_PIS\",\n",
    "        \"VL_BC_COFINS\", \"ALIQ_COFINS\", \"VL_COFINS\",\n",
    "    ],\n",
    "    \"silver.nfse_documents\": [\n",
    "        \"service_value\", \"source_iss_rate_pct\", \"source_iss_value\",\n",
    "        \"source_pis_value\", \"source_cofins_value\", \"source_rtc_base\",\n",
    "    ],\n",
    "    \"silver.service_operations\": [\n",
    "        \"service_value\", \"source_iss_rate_pct\", \"source_iss_value\",\n",
    "        \"source_pis_value\", \"source_cofins_value\", \"source_rtc_base\",\n",
    "        \"efd_pis_value\", \"efd_cofins_value\", \"efd_iss_value\",\n",
    "        \"ibs_reduction_pct\", \"cbs_reduction_pct\",\n",
    "    ],\n",
    "    \"gold.simulation_detail\": [\n",
    "        \"simple_purchase_share\", \"service_value\", \"legacy_iss_value\", \"rtc_base\",\n",
    "        \"ibs_effective_rate_pct\", \"cbs_effective_rate_pct\", \"rtc_debit\",\n",
    "        \"rtc_credit_potential_known\", \"unknown_credit_base\",\n",
    "    ],\n",
    "    \"gold.simulation_summary\": [\n",
    "        \"simple_purchase_share\", \"active_revenue_value\", \"active_purchase_value\",\n",
    "        \"cancelled_revenue_excluded_value\", \"observed_legacy_pis_cofins_payable\",\n",
    "        \"observed_legacy_iss_payable\", \"legacy_tax_in_scenario\", \"rtc_debit\",\n",
    "        \"rtc_credit_potential_known\", \"rtc_unknown_credit_base\",\n",
    "        \"rtc_net_tax_known_upper_bound\", \"rtc_credit_appropriable_current_period\",\n",
    "        \"rtc_cash_payment_current_period\", \"total_cash_need_current_period\",\n",
    "        \"delta_cash_vs_observed_legacy\",\n",
    "    ],\n",
    "}\n",
    "\n",
    "def persist_to_fabric() -> str:\n",
    "    if not IN_FABRIC or not PERSIST_TO_FABRIC:\n",
    "        return \"SKIPPED\"\n",
    "\n",
    "    from pyspark.sql import functions as F\n",
    "\n",
    "    for schema_name in (\"bronze\", \"silver\", \"gold\"):\n",
    "        spark.sql(f\"CREATE SCHEMA IF NOT EXISTS {schema_name}\")\n",
    "\n",
    "    run_table = \"gold.simulation_runs\"\n",
    "    if spark.catalog.tableExists(run_table):\n",
    "        completed = (\n",
    "            spark.table(run_table)\n",
    "            .filter(\n",
    "                (F.col(\"simulation_run_id\") == simulation_run_id)\n",
    "                & (F.col(\"status\") == \"COMPLETED\")\n",
    "            )\n",
    "            .limit(1)\n",
    "            .count()\n",
    "        )\n",
    "        if completed and not FORCE_RECOMPUTE:\n",
    "            print(\n",
    "                f\"{simulation_run_id} já está COMPLETED. \"\n",
    "                \"Persistência ignorada para preservar imutabilidade.\"\n",
    "            )\n",
    "            return \"REUSED_COMPLETED_RUN\"\n",
    "\n",
    "    for table_name, pandas_df in FABRIC_TABLES.items():\n",
    "        spark_df = spark.createDataFrame(clean_records_for_spark(pandas_df))\n",
    "        for col_name in DECIMAL_COLUMNS.get(table_name, []):\n",
    "            if col_name in spark_df.columns:\n",
                scale = 6 if (
                    "rate" in col_name.lower()
                    or "aliq" in col_name.lower()
                    or "share" in col_name.lower()
                    or col_name.lower().endswith("_pct")
                ) else 2
    "                spark_df = spark_df.withColumn(\n",
    "                    col_name,\n",
    "                    F.col(col_name).cast(f\"decimal(18,{scale})\"),\n",
    "                )\n",
    "        spark_df.write.format(\"delta\").mode(\"append\").saveAsTable(table_name)\n",
    "        print(f\"persisted {table_name}: {pandas_df.shape[0]} rows\")\n",
    "\n",
    "    spark.createDataFrame(clean_records_for_spark(run_manifest)).write.format(\n",
    "        \"delta\"\n",
    "    ).mode(\"append\").saveAsTable(run_table)\n",
    "\n",
    "    return \"PERSISTED\"\n",
    "\n",
    "fabric_persistence_status = persist_to_fabric()\n",
    "print(f\"fabric_persistence_status={fabric_persistence_status}\")"
   ]
  },
