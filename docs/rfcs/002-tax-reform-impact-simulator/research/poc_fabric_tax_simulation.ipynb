   "source": [
    "## 2. EFD-Contribuições — parser orientado pelo catálogo de leiaute\n",
    "\n",
    "A EFD é TXT posicional; portanto o código usa explicitamente `sped_layout_fields.csv`, filtrado por `type_sped == \"EFD-CONTRIBUIÇÕES\"`.\n",
    "\n",
    "O catálogo contém outras obrigações e cabeçalhos duplicados. A POC:\n",
    "- normaliza os nomes duplicados apenas em memória;\n",
    "- filtra a obrigação explicitamente;\n",
    "- mantém `source_line`, `record_id` determinístico e hierarquia por `level`;\n",
    "- materializa somente os registros necessários (`A100`, `A170`, `M200`, `M600`);\n",
    "- **não tenta virar um parser SPED universal**.\n",
    "\n",
    "O catálogo atual mistura versões históricas em alguns registros (por exemplo, M210/M610). A POC não usa esses registros para cálculo; o Bloco M aqui serve como controle do PIS/Cofins observado."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3cc57a99",
   "metadata": {},
   "outputs": [],
   "source": [
    "def dedupe_names(names: list[str]) -> list[str]:\n",
    "    seen: Counter[str] = Counter()\n",
    "    result = []\n",
    "    for name in names:\n",
    "        seen[name] += 1\n",
    "        result.append(name if seen[name] == 1 else f\"{name}__{seen[name]}\")\n",
    "    return result\n",
    "\n",
    "def load_sped_layout_catalog(path: Path, obligation: str) -> pd.DataFrame:\n",
    "    with path.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as fh:\n",
    "        first = fh.readline().strip()\n",
    "        if first.lower() != \"sep=,\":\n",
    "            raise ValueError(\"sped_layout_fields.csv não inicia com 'sep=,'.\")\n",
    "        reader = csv.reader(fh)\n",
    "        header = dedupe_names(next(reader))\n",
    "        rows = list(reader)\n",
    "    catalog = pd.DataFrame(rows, columns=header)\n",
    "    selected = catalog[catalog[\"type_sped\"] == obligation].copy()\n",
    "    if selected.empty:\n",
    "        raise ValueError(f\"Obrigação {obligation!r} não encontrada no catálogo.\")\n",
    "    return selected\n",
    "\n",
    "layout = load_sped_layout_catalog(layout_path, SPED_OBLIGATION)\n",
    "\n",
    "print(f\"layout_rows_total_obligation={len(layout)}\")\n",
    "print(f\"layout_registers={layout['register'].nunique()}\")\n",
    "\n",
    "register_meta = (\n",
    "    layout[[\"register\", \"block\", \"level\"]]\n",
    "    .drop_duplicates(\"register\")\n",
    "    .set_index(\"register\")\n",
    "    .to_dict(\"index\")\n",
    ")\n",
    "\n",
    "SELECTED_REGISTERS = {\"A100\", \"A170\", \"M200\", \"M600\"}\n",
    "\n",
    "field_specs: dict[str, list[dict[str, Any]]] = {}\n",
    "for register, group in layout[layout[\"register\"].isin(SELECTED_REGISTERS)].groupby(\"register\"):\n",
    "    specs = []\n",
    "    for _, row in group.sort_values(\"index\", key=lambda s: s.astype(int)).iterrows():\n",
    "        specs.append({\n",
    "            \"index\": int(row[\"index\"]),\n",
    "            \"name\": row[\"code__2\"],\n",
    "            \"type\": row[\"type\"],\n",
    "            \"required\": row[\"required__2\"] == \"True\",\n",
    "        })\n",
    "    field_specs[register] = specs\n",
    "\n",
    "def parse_br_decimal(value: str) -> Decimal | None:\n",
    "    value = value.strip()\n",
    "    if value == \"\":\n",
    "        return None\n",
    "    return Decimal(value.replace(\".\", \"\").replace(\",\", \".\"))\n",
    "\n",
    "def parse_br_date(value: str) -> date | None:\n",
    "    value = value.strip()\n",
    "    if value == \"\":\n",
    "        return None\n",
    "    return datetime.strptime(value, \"%d%m%Y\").date()\n",
    "\n",
    "def convert_sped_value(value: str, field_type: str) -> Any:\n",
    "    if value == \"\":\n",
    "        return None\n",
    "    if field_type == \"float\":\n",
    "        return parse_br_decimal(value)\n",
    "    if field_type == \"date\":\n",
    "        return parse_br_date(value)\n",
    "    return value\n",
    "\n",
    "def parse_efd(\n",
    "    path: Path,\n",
    "    source_sha: str,\n",
    ") -> tuple[pd.DataFrame, pd.DataFrame, list[str]]:\n",
    "    parsed_rows = []\n",
    "    bronze_rows = []\n",
    "    errors: list[str] = []\n",
    "    stack: dict[int, str] = {}\n",
    "\n",
    "    for line_number, raw_line in enumerate(path.read_text(encoding=\"utf-8\").splitlines(), start=1):\n",
    "        parts = raw_line.split(\"|\")\n",
    "        if len(parts) < 3 or parts[0] != \"\":\n",
    "            errors.append(f\"linha {line_number}: estrutura SPED inesperada\")\n",
    "            continue\n",
    "\n",
    "        register = parts[1]\n",
    "        record_id = f\"efd_{source_sha[:12]}_{line_number:06d}_{register}\"\n",
    "        level_raw = register_meta.get(register, {}).get(\"level\")\n",
    "        level = int(level_raw) if level_raw not in (None, \"\") else None\n",
    "\n",
    "        parent_record_id = None\n",
    "        if level is not None:\n",
    "            for stack_level in sorted([x for x in stack if x >= level], reverse=True):\n",
    "                stack.pop(stack_level, None)\n",
    "            lower_levels = [x for x in stack if x < level]\n",
    "            if lower_levels:\n",
    "                parent_record_id = stack[max(lower_levels)]\n",
    "            stack[level] = record_id\n",
    "\n",
    "        bronze_rows.append({\n",
    "            \"record_id\": record_id,\n",
    "            \"source_file\": path.name,\n",
    "            \"source_file_sha256\": source_sha,\n",
    "            \"source_line\": line_number,\n",
    "            \"register\": register,\n",
    "            \"level\": level,\n",
    "            \"parent_record_id\": parent_record_id,\n",
    "            \"raw_line\": raw_line,\n",
    "        })\n",
    "\n",
    "        if register not in SELECTED_REGISTERS:\n",
    "            continue\n",
    "\n",
    "        row = {\n",
    "            \"record_id\": record_id,\n",
    "            \"source_file\": path.name,\n",
    "            \"source_file_sha256\": source_sha,\n",
    "            \"source_line\": line_number,\n",
    "            \"register\": register,\n",
    "            \"parent_record_id\": parent_record_id,\n",
    "        }\n",
    "\n",
    "        # A100 com COD_SIT=02 (cancelado) é intencionalmente mínimo na fixture e\n",
    "        # foi validado dessa forma no PVA. O catálogo genérico marca vários campos\n",
    "        # como obrigatórios para o caso normal, mas não representa todas as regras\n",
    "        # condicionais por situação do documento. Não \"corrigir\" o arquivo cancelado\n",
    "        # preenchendo valores fictícios.\n",
    "        cancelled_a100 = (\n",
    "            register == \"A100\"\n",
    "            and len(parts) > 5\n",
    "            and parts[5] == \"02\"\n",
    "        )\n",
    "\n",
    "        for spec in field_specs.get(register, []):\n",
    "            idx = spec[\"index\"]\n",
    "            raw_value = parts[idx] if idx < len(parts) else \"\"\n",
    "            if (\n",
    "                spec[\"required\"]\n",
    "                and raw_value == \"\"\n",
    "                and not cancelled_a100\n",
    "            ):\n",
    "                errors.append(\n",
    "                    f\"linha {line_number} {register}.{spec['name']}: campo obrigatório vazio\"\n",
    "                )\n",
    "            try:\n",
    "                row[spec[\"name\"]] = convert_sped_value(raw_value, spec[\"type\"])\n",
    "            except Exception as exc:\n",
    "                errors.append(\n",
    "                    f\"linha {line_number} {register}.{spec['name']}: {exc}\"\n",
    "                )\n",
    "                row[spec[\"name\"]] = None\n",
    "\n",
    "        parsed_rows.append(row)\n",
    "\n",
    "    return (\n",
    "        pd.DataFrame(parsed_rows),\n",
    "        pd.DataFrame(bronze_rows),\n",
    "        errors,\n",
    "    )\n",
    "\n",
