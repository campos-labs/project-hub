    "\n",
    "for scenario_id, expected in expected_debits.items():\n",
    "    values = set(\n",
    "        gold_simulation_summary.loc[\n",
    "            gold_simulation_summary[\"scenario_id\"] == scenario_id,\n",
    "            \"rtc_debit\",\n",
    "        ]\n",
    "    )\n",
    "    assert values == {expected}, (scenario_id, values, expected)\n",
    "\n",
    "    simple0 = gold_simulation_summary[\n",
    "        (gold_simulation_summary[\"scenario_id\"] == scenario_id)\n",
    "        & (gold_simulation_summary[\"supplier_case_id\"] == \"simple_0\")\n",
    "    ].iloc[0]\n",
    "    assert simple0[\"rtc_credit_potential_known\"] == expected_simple0_credits[scenario_id]\n",
    "    assert simple0[\"rtc_unknown_credit_base\"] == Decimal(\"0\")\n",
    "    assert simple0[\"rtc_net_tax_status\"] == \"DETERMINISTIC\"\n",
    "\n",
    "assert len(gold_simulation_detail) == 36  # 4 operações ativas × 3 cenários × 3 sensibilidades\n",
