   "source": [
    "## 5. Controles fiscais observados e Gold de cenários\n",
    "\n",
    "O Bloco M é usado como **controle** do PIS/Cofins observado:\n",
    "- M200 → PIS a recolher;\n",
    "- M600 → Cofins a recolher.\n",
    "\n",
    "O ISS legado é somado apenas nas receitas ativas, pois ISS de compras não é passivo da empresa simulada.\n",
    "\n",
    "### Base RTC na POC\n",
    "\n",
    "- **2026:** usa `source_rtc_base` da NFS-e quando existente, pois é o ano-teste documentado. Se o XML do fornecedor Simples não traz a base RTC, usa o valor do serviço apenas como base de sensibilidade e marca a origem.\n",
    "- **2029/2033:** usa o valor bruto do serviço como **`SCENARIO_ASSUMPTION`** para reprecificação analítica. Não é afirmação de apuração legal.\n",
    "- reduções vêm exclusivamente de `rtc_service_rules.csv`;\n",
    "- IBS aplica `ibs_transition_factor`;\n",
    "- arredondamento monetário é `HALF_UP` por operação/componente.\n",
    "\n",
    "### Crédito do fornecedor Simples\n",
    "\n",
    "A parcela que permanece no Simples não recebe crédito inventado. Ela gera `unknown_credit_base` e status `INSUFFICIENT_DATA`. A parcela contrafactual que deixa o Simples usa o tratamento RTC padrão como `ESTIMATED_EXPANSION`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ce0b19f0",
   "metadata": {},
   "outputs": [],
   "source": [
    "MONEY_QUANT = Decimal(\"0.01\")\n",
    "\n",
    "def money(value: Decimal) -> Decimal:\n",
    "    return value.quantize(MONEY_QUANT, rounding=ROUND_HALF_UP)\n",
    "\n",
    "def pct(value: Any) -> Decimal:\n",
    "    return Decimal(str(value))\n",
    "\n",
    "def sum_dec(values) -> Decimal:\n",
    "    total = Decimal(\"0\")\n",
    "    for value in values:\n",
    "        if value is not None and not pd.isna(value):\n",
    "            total += value\n",
    "    return total\n",
    "\n",
    "active_ops = silver_service_operations[\n",
    "    silver_service_operations[\"lifecycle_status\"] == \"ACTIVE\"\n",
    "].copy()\n",
    "\n",
    "active_revenue = active_ops[active_ops[\"direction\"] == \"REVENUE\"]\n",
    "active_purchase = active_ops[active_ops[\"direction\"] == \"PURCHASE\"]\n",
    "cancelled_revenue = silver_service_operations[\n",
    "    (silver_service_operations[\"direction\"] == \"REVENUE\")\n",
    "    & (silver_service_operations[\"lifecycle_status\"] == \"CANCELLED\")\n",
    "]\n",
    "\n",
    "observed_pis_payable = efd_m200.iloc[0][\"VL_TOT_CONT_REC\"]\n",
    "observed_cofins_payable = efd_m600.iloc[0][\"VL_TOT_CONT_REC\"]\n",
    "observed_pis_cofins_payable = observed_pis_payable + observed_cofins_payable\n",
    "observed_iss_payable = sum_dec(active_revenue[\"source_iss_value\"])\n",
    "observed_legacy_baseline = observed_pis_cofins_payable + observed_iss_payable\n",
    "\n",
    "# Reconciliações determinísticas da fixture.\n",
    "revenue_pis = sum_dec(active_revenue[\"efd_pis_value\"])\n",
    "purchase_pis = sum_dec(active_purchase[\"efd_pis_value\"])\n",
    "revenue_cofins = sum_dec(active_revenue[\"efd_cofins_value\"])\n",
    "purchase_cofins = sum_dec(active_purchase[\"efd_cofins_value\"])\n",
    "\n",
    "assert money(revenue_pis - purchase_pis) == observed_pis_payable == Decimal(\"1815.00\")\n",
    "assert money(revenue_cofins - purchase_cofins) == observed_cofins_payable == Decimal(\"8360.00\")\n",
    "assert observed_iss_payable == Decimal(\"4350.00\")\n",
    "assert observed_legacy_baseline == Decimal(\"14525.00\")\n",
    "assert sum_dec(active_revenue[\"service_value\"]) == Decimal(\"150000.00\")\n",
    "assert sum_dec(active_purchase[\"service_value\"]) == Decimal(\"60000.00\")\n",
    "assert sum_dec(cancelled_revenue[\"service_value\"]) == Decimal(\"25000.00\")\n",
    "\n",
    "supplier_cases = fixture[\"supplier_scenarios\"][\"cases\"]\n",
    "scenario_rows = []\n",
    "\n",
    "for scenario_id, scenario in fixture[\"scenarios\"].items():\n",
    "    ref_year = int(scenario[\"reference_year\"])\n",
    "    ibs_ref_pct = pct(scenario[\"rtc\"][\"ibs_reference_rate_pct\"])\n",
    "    cbs_ref_pct = pct(scenario[\"rtc\"][\"cbs_reference_rate_pct\"])\n",
    "    ibs_factor = pct(scenario[\"rtc\"][\"ibs_transition_factor\"])\n",
    "\n",
    "    for supplier_case_id, supplier_case in supplier_cases.items():\n",
    "        simple_share = pct(supplier_case[\"simple_purchase_share\"])\n",
    "\n",
    "        for _, op in active_ops.iterrows():\n",
    "            if op[\"ibs_reduction_pct\"] is None or op[\"cbs_reduction_pct\"] is None:\n",
    "                raise AssertionError(\n",
    "                    f\"{op['source_nfse_file']}: tratamento RTC insuficiente para cálculo.\"\n",
    "                )\n",
    "\n",
    "            ibs_reduction = pct(op[\"ibs_reduction_pct\"])\n",
    "            cbs_reduction = pct(op[\"cbs_reduction_pct\"])\n",
    "\n",
    "            if ref_year == 2026 and op[\"source_rtc_base\"] is not None:\n",
    "                rtc_base = op[\"source_rtc_base\"]\n",
    "                rtc_base_source = \"NFSE_DOCUMENT_2026\"\n",
    "            else:\n",
    "                rtc_base = op[\"service_value\"]\n",
    "                rtc_base_source = (\n",
    "                    \"SCENARIO_GROSS_SERVICE_VALUE\"\n",
    "                    if ref_year != 2026\n",
    "                    else \"ESTIMATED_SERVICE_VALUE_MISSING_DOCUMENT_BASE\"\n",
    "                )\n",
    "\n",
    "            ibs_effective_pct = (\n",
    "                ibs_ref_pct\n",
    "                * ibs_factor\n",
    "                * (Decimal(\"1\") - ibs_reduction / Decimal(\"100\"))\n",
    "            )\n",
    "            cbs_effective_pct = (\n",
    "                cbs_ref_pct\n",
    "                * (Decimal(\"1\") - cbs_reduction / Decimal(\"100\"))\n",
    "            )\n",
    "\n",
    "            rtc_debit = Decimal(\"0\")\n",
    "            rtc_credit_potential_known = Decimal(\"0\")\n",
    "            unknown_credit_base = Decimal(\"0\")\n",
    "            credit_status = \"NOT_APPLICABLE\"\n",
    "\n",
    "            if op[\"direction\"] == \"REVENUE\":\n",
    "                ibs_value = money(rtc_base * ibs_effective_pct / Decimal(\"100\"))\n",
    "                cbs_value = money(rtc_base * cbs_effective_pct / Decimal(\"100\"))\n",
    "                rtc_debit = ibs_value + cbs_value\n",
    "                known_credit_base = Decimal(\"0\")\n",
    "\n",
    "            else:\n",
    "                if bool(op[\"supplier_simple\"]):\n",
    "                    known_credit_base = money(\n",
    "                        rtc_base * (Decimal(\"1\") - simple_share)\n",
    "                    )\n",
    "                    unknown_credit_base = money(rtc_base * simple_share)\n",
    "\n",
    "                    if simple_share == Decimal(\"0\"):\n",
    "                        credit_status = \"ESTIMATED_EXPANSION\"\n",
    "                    else:\n",
    "                        credit_status = \"INSUFFICIENT_DATA\"\n",
    "                else:\n",
    "                    known_credit_base = rtc_base\n",
    "                    credit_status = \"MAINTAINED\"\n",
    "\n",
    "                ibs_credit = money(\n",
    "                    known_credit_base * ibs_effective_pct / Decimal(\"100\")\n",
    "                )\n",
    "                cbs_credit = money(\n",
    "                    known_credit_base * cbs_effective_pct / Decimal(\"100\")\n",
    "                )\n",
    "                rtc_credit_potential_known = ibs_credit + cbs_credit\n",
    "\n",
    "            scenario_rows.append({\n",
    "                \"company_id\": fixture[\"fixture\"][\"company_id\"],\n",
    "                \"base_period\": fixture[\"fixture\"][\"base_period\"],\n",
    "                \"scenario_id\": scenario_id,\n",
    "                \"scenario_label\": scenario[\"label\"],\n",
    "                \"reference_year\": ref_year,\n",
    "                \"rate_status\": scenario[\"rtc\"][\"rate_status\"],\n",
    "                \"supplier_case_id\": supplier_case_id,\n",
    "                \"supplier_case_label\": supplier_case[\"label\"],\n",
    "                \"simple_purchase_share\": simple_share,\n",
    "                \"nfse_key\": op[\"nfse_key\"],\n",
    "                \"nfse_number\": op[\"nfse_number\"],\n",
    "                \"direction\": op[\"direction\"],\n",
    "                \"source_nfse_file\": op[\"source_nfse_file\"],\n",
    "                \"service_description\": op[\"service_description\"],\n",
    "                \"service_item\": op[\"service_item\"],\n",
    "                \"nbs\": op[\"nbs\"],\n",
    "                \"supplier_simple\": bool(op[\"supplier_simple\"]),\n",
    "                \"classification_status\": op[\"classification_status\"],\n",
    "                \"service_value\": op[\"service_value\"],\n",
    "                \"legacy_iss_value\": op[\"source_iss_value\"],\n",
    "                \"rtc_base\": rtc_base,\n",
    "                \"rtc_base_source\": rtc_base_source,\n",
    "                \"ibs_effective_rate_pct\": ibs_effective_pct,\n",
    "                \"cbs_effective_rate_pct\": cbs_effective_pct,\n",
    "                \"rtc_debit\": rtc_debit,\n",
    "                \"rtc_credit_potential_known\": rtc_credit_potential_known,\n",
    "                \"unknown_credit_base\": unknown_credit_base,\n",
    "                \"credit_status\": credit_status,\n",
    "            })\n",
    "\n",
    "gold_simulation_detail = pd.DataFrame(scenario_rows)\n",
    "\n",
    "summary_rows = []\n",
    "credit_delay_months = int(fixture[\"cash_flow\"][\"credit_appropriation_delay_months\"])\n",
    "\n",
    "for (scenario_id, supplier_case_id), group in gold_simulation_detail.groupby(\n",
    "    [\"scenario_id\", \"supplier_case_id\"],\n",
    "    sort=False,\n",
    "):\n",
    "    scenario = fixture[\"scenarios\"][scenario_id]\n",
    "    supplier_case = supplier_cases[supplier_case_id]\n",
    "\n",
    "    rtc_debit = sum_dec(group[\"rtc_debit\"])\n",
    "    credit_known = sum_dec(group[\"rtc_credit_potential_known\"])\n",
    "    unknown_base = sum_dec(group[\"unknown_credit_base\"])\n",
    "\n",
    "    # O crédito tem atraso de 1 mês nesta POC; em uma fixture de um único período\n",
    "    # ele não é apropriável no mesmo período. Não modelamos saldos anteriores.\n",
    "    credit_appropriable_current_period = (\n",
    "        credit_known if credit_delay_months == 0 else Decimal(\"0\")\n",
    "    )\n",
    "\n",
    "    net_known_upper_bound = money(max(rtc_debit - credit_known, Decimal(\"0\")))\n",
    "    net_status = \"INSUFFICIENT_DATA\" if unknown_base > 0 else \"DETERMINISTIC\"\n",
    "\n",
    "    legacy_tax = money(\n",
    "        observed_pis_cofins_payable * pct(scenario[\"legacy\"][\"pis_cofins_share\"])\n",
    "        + observed_iss_payable * pct(scenario[\"legacy\"][\"iss_share\"])\n",
    "    )\n",
    "\n",
    "    include_rtc_payment = bool(scenario[\"cash_flow\"][\"include_rtc_payment\"])\n",
    "    rtc_cash_current_period = (\n",
    "        money(max(rtc_debit - credit_appropriable_current_period, Decimal(\"0\")))\n",
    "        if include_rtc_payment\n",
    "        else Decimal(\"0\")\n",
    "    )\n",
    "    total_cash_current_period = legacy_tax + rtc_cash_current_period\n",
    "\n",
    "    summary_rows.append({\n",
    "        \"company_id\": fixture[\"fixture\"][\"company_id\"],\n",
    "        \"base_period\": fixture[\"fixture\"][\"base_period\"],\n",
    "        \"scenario_id\": scenario_id,\n",
    "        \"scenario_label\": scenario[\"label\"],\n",
    "        \"reference_year\": int(scenario[\"reference_year\"]),\n",
    "        \"rate_status\": scenario[\"rtc\"][\"rate_status\"],\n",
    "        \"supplier_case_id\": supplier_case_id,\n",
    "        \"supplier_case_label\": supplier_case[\"label\"],\n",
    "        \"simple_purchase_share\": pct(supplier_case[\"simple_purchase_share\"]),\n",
    "        \"active_revenue_value\": sum_dec(\n",
    "            group.loc[group[\"direction\"] == \"REVENUE\", \"service_value\"]\n",
    "        ),\n",
    "        \"active_purchase_value\": sum_dec(\n",
    "            group.loc[group[\"direction\"] == \"PURCHASE\", \"service_value\"]\n",
    "        ),\n",
    "        \"cancelled_revenue_excluded_value\": sum_dec(cancelled_revenue[\"service_value\"]),\n",
    "        \"observed_legacy_pis_cofins_payable\": observed_pis_cofins_payable,\n",
    "        \"observed_legacy_iss_payable\": observed_iss_payable,\n",
    "        \"legacy_tax_in_scenario\": legacy_tax,\n",
    "        \"rtc_debit\": rtc_debit,\n",
    "        \"rtc_credit_potential_known\": credit_known,\n",
    "        \"rtc_unknown_credit_base\": unknown_base,\n",
    "        \"rtc_net_tax_known_upper_bound\": net_known_upper_bound,\n",
    "        \"rtc_net_tax_status\": net_status,\n",
    "        \"credit_appropriation_delay_months\": credit_delay_months,\n",
    "        \"rtc_credit_appropriable_current_period\": credit_appropriable_current_period,\n",
    "        \"rtc_cash_payment_current_period\": rtc_cash_current_period,\n",
    "        \"total_cash_need_current_period\": total_cash_current_period,\n",
    "        \"delta_cash_vs_observed_legacy\": money(\n",
    "            total_cash_current_period - observed_legacy_baseline\n",
    "        ),\n",
    "        \"split_payment_status\": fixture[\"cash_flow\"][\"split_payment\"],\n",
    "    })\n",
    "\n",
    "gold_simulation_summary = pd.DataFrame(summary_rows)\n",
    "\n",
    "# Valores determinísticos esperados desta fixture.\n",
    "expected_debits = {\n",
    "    \"baseline_2026\": Decimal(\"1317.76\"),\n",
    "    \"transition_2029\": Decimal(\"16350.00\"),\n",
    "    \"full_2033\": Decimal(\"42000.00\"),\n",
    "}\n",
    "expected_simple0_credits = {\n",
    "    \"baseline_2026\": Decimal(\"543.00\"),\n",
    "    \"transition_2029\": Decimal(\"6540.00\"),\n",
    "    \"full_2033\": Decimal(\"16800.00\"),\n",
