    "## 6. Paridade local com DuckDB\n",
    "\n",
    "DuckDB é apenas referência local/diagnóstica. Não é runtime produtivo da v1.\n",
    "\n",
    "A comparação abaixo reconstrói, por SQL, os agregados de débito/crédito a partir do Gold detalhado e exige igualdade monetária com o resumo Pandas. Se `duckdb` não estiver instalado no ambiente local, instale-o no ambiente Python do VS Code (`python -m pip install duckdb`) e execute novamente.\n",
    "\n",
    "No Fabric, esta etapa é desligada automaticamente porque a paridade já deve ter sido comprovada antes da publicação."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ec2dca36",
   "metadata": {},
   "outputs": [],
   "source": [
    "duckdb_parity_status = \"SKIPPED_FABRIC_OR_DISABLED\"\n",
    "\n",
    "if RUN_DUCKDB_PARITY:\n",
    "    try:\n",
    "        import duckdb\n",
    "    except ModuleNotFoundError as exc:\n",
    "        raise RuntimeError(\n",
    "            \"DuckDB é necessário para a validação local da hipótese. \"\n",
    "            \"Instale no mesmo ambiente Python do Notebook com: python -m pip install duckdb\"\n",
    "        ) from exc\n",
    "\n",
    "    con = duckdb.connect(database=\":memory:\")\n",
    "    con.register(\"gold_detail\", gold_simulation_detail)\n",
    "\n",
    "    duckdb_summary = con.execute(\"\"\"\n",
    "        SELECT\n",
    "            scenario_id,\n",
    "            supplier_case_id,\n",
    "            SUM(CAST(rtc_debit AS DECIMAL(18,2))) AS rtc_debit,\n",
    "            SUM(CAST(rtc_credit_potential_known AS DECIMAL(18,2))) AS rtc_credit_potential_known,\n",
    "            SUM(CAST(unknown_credit_base AS DECIMAL(18,2))) AS rtc_unknown_credit_base\n",
    "        FROM gold_detail\n",
    "        GROUP BY scenario_id, supplier_case_id\n",
    "        ORDER BY scenario_id, supplier_case_id\n",
    "    \"\"\").df()\n",
    "\n",
    "    pandas_check = gold_simulation_summary[\n",
    "        [\n",
    "            \"scenario_id\",\n",
    "            \"supplier_case_id\",\n",
    "            \"rtc_debit\",\n",
    "            \"rtc_credit_potential_known\",\n",
    "            \"rtc_unknown_credit_base\",\n",
    "        ]\n",
    "    ].copy()\n",
    "\n",
    "    def money_strings(df: pd.DataFrame) -> pd.DataFrame:\n",
    "        out = df.copy()\n",
    "        for col in [\n",
    "            \"rtc_debit\",\n",
    "            \"rtc_credit_potential_known\",\n",
    "            \"rtc_unknown_credit_base\",\n",
    "        ]:\n",
    "            out[col] = out[col].map(lambda x: f\"{Decimal(str(x)):.2f}\")\n",
    "        return out.sort_values([\"scenario_id\", \"supplier_case_id\"]).reset_index(drop=True)\n",
    "\n",
    "    left = money_strings(pandas_check)\n",
    "    right = money_strings(duckdb_summary)\n",
    "\n",
    "    pd.testing.assert_frame_equal(left, right, check_dtype=False)\n",
    "    duckdb_parity_status = \"PASS\"\n",
    "\n",
    "print(f\"duckdb_parity_status={duckdb_parity_status}\")"
   ]
  },
