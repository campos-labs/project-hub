    "## 3. NFS-e Nacional XML + eventos\n",
    "\n",
    "A POC **não valida XSD em runtime**. Ela valida apenas o contrato necessário ao processamento: namespace, versão, estrutura esperada e campos consumidos.\n",
    "\n",
    "A direção é derivada pelo CNPJ da empresa:\n",
    "- empresa = prestador → `REVENUE`;\n",
    "- empresa = tomador → `PURCHASE`.\n",
    "\n",
    "O cancelamento é um evento separado `101101`. O XML original da NFS-e 1003 permanece íntegro."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9397a1fc",
   "metadata": {},
   "outputs": [],
   "source": [
    "def local_name(tag: str) -> str:\n",
    "    return tag.split(\"}\", 1)[-1] if \"}\" in tag else tag\n",
    "\n",
    "def decimal_or_none(value: str | None) -> Decimal | None:\n",
    "    if value is None or value.strip() == \"\":\n",
    "        return None\n",
    "    return Decimal(value)\n",
    "\n",
    "def xml_text(node: ET.Element | None, path: str, ns: dict[str, str]) -> str | None:\n",
    "    if node is None:\n",
    "        return None\n",
    "    found = node.find(path, ns)\n",
    "    return None if found is None else found.text\n",
    "\n",
    "def parse_nfse_document(path: Path, expected_namespace: str, company_cnpj: str) -> dict[str, Any]:\n",
    "    root = ET.parse(path).getroot()\n",
    "    if local_name(root.tag) != \"NFSe\":\n",
    "        raise ValueError(f\"{path.name}: raiz esperada NFSe, obtida {local_name(root.tag)}\")\n",
    "    if not root.tag.startswith(f\"{{{expected_namespace}}}\"):\n",
    "        raise ValueError(f\"{path.name}: namespace inesperado\")\n",
    "    if root.attrib.get(\"versao\") != SUPPORTED_NFSE_VERSION:\n",
    "        raise ValueError(f\"{path.name}: versão não suportada {root.attrib.get('versao')}\")\n",
    "\n",
    "    ns = {\"n\": expected_namespace}\n",
    "    inf = root.find(\"n:infNFSe\", ns)\n",
    "    dps = root.find(\"n:infNFSe/n:DPS/n:infDPS\", ns)\n",
    "    if inf is None or dps is None:\n",
    "        raise ValueError(f\"{path.name}: infNFSe/DPS ausente\")\n",
    "\n",
    "    nfse_id = inf.attrib.get(\"Id\", \"\")\n",
    "    if not nfse_id.startswith(\"NFS\"):\n",
    "        raise ValueError(f\"{path.name}: Id de NFS-e inesperado\")\n",
    "    nfse_key = nfse_id[3:]\n",
    "\n",
    "    prest_cnpj = xml_text(dps, \"n:prest/n:CNPJ\", ns)\n",
    "    toma_cnpj = xml_text(dps, \"n:toma/n:CNPJ\", ns)\n",
    "    if prest_cnpj == company_cnpj:\n",
    "        direction = \"REVENUE\"\n",
    "    elif toma_cnpj == company_cnpj:\n",
    "        direction = \"PURCHASE\"\n",
    "    else:\n",
    "        direction = \"OUT_OF_SCOPE\"\n",
    "\n",
    "    reg_trib = dps.find(\"n:prest/n:regTrib\", ns)\n",
    "    op_simp_nac = xml_text(reg_trib, \"n:opSimpNac\", ns)\n",
    "\n",
    "    ctrib = xml_text(dps, \"n:serv/n:cServ/n:cTribNac\", ns)\n",
    "    cnbs = xml_text(dps, \"n:serv/n:cServ/n:cNBS\", ns)\n",
    "    if not ctrib or not cnbs:\n",
    "        raise ValueError(f\"{path.name}: cTribNac/cNBS obrigatório para esta POC\")\n",
    "\n",
    "    piscofins = dps.find(\"n:valores/n:trib/n:tribFed/n:piscofins\", ns)\n",
    "    declared_ibscbs = dps.find(\"n:IBSCBS\", ns)\n",
    "    generated_ibscbs = inf.find(\"n:IBSCBS\", ns)\n",
    "\n",
    "    return {\n",
    "        \"source_nfse_file\": path.name,\n",
    "        \"nfse_key\": nfse_key,\n",
    "        \"nfse_number\": xml_text(inf, \"n:nNFSe\", ns),\n",
    "        \"nfse_status_code\": xml_text(inf, \"n:cStat\", ns),\n",
    "        \"process_datetime\": xml_text(inf, \"n:dhProc\", ns),\n",
    "        \"competence_date\": xml_text(dps, \"n:dCompet\", ns),\n",
    "        \"prestador_cnpj\": prest_cnpj,\n",
    "        \"tomador_cnpj\": toma_cnpj,\n",
    "        \"direction\": direction,\n",
    "        \"prestador_op_simp_nac\": op_simp_nac,\n",
    "        \"supplier_simple\": direction == \"PURCHASE\" and op_simp_nac == \"3\",\n",
    "        \"service_description\": xml_text(dps, \"n:serv/n:cServ/n:xDescServ\", ns),\n",
    "        \"ctrib_nacional\": ctrib,\n",
    "        \"nbs\": cnbs,\n",
    "        \"service_value\": decimal_or_none(xml_text(dps, \"n:valores/n:vServPrest/n:vServ\", ns)),\n",
    "        \"source_iss_rate_pct\": decimal_or_none(xml_text(dps, \"n:valores/n:trib/n:tribMun/n:pAliq\", ns)),\n",
    "        \"source_iss_value\": decimal_or_none(xml_text(inf, \"n:valores/n:vISSQN\", ns)) or Decimal(\"0\"),\n",
    "        \"source_pis_value\": decimal_or_none(xml_text(piscofins, \"n:vPis\", ns)),\n",
    "        \"source_cofins_value\": decimal_or_none(xml_text(piscofins, \"n:vCofins\", ns)),\n",
    "        \"source_rtc_base\": decimal_or_none(xml_text(generated_ibscbs, \"n:valores/n:vBC\", ns)),\n",
    "        \"source_cindop\": xml_text(declared_ibscbs, \"n:cIndOp\", ns),\n",
    "        \"source_cst_ibscbs\": xml_text(declared_ibscbs, \"n:valores/n:trib/n:gIBSCBS/n:CST\", ns),\n",
    "        \"source_cclasstrib\": xml_text(declared_ibscbs, \"n:valores/n:trib/n:gIBSCBS/n:cClassTrib\", ns),\n",
    "    }\n",
    "\n",
    "def parse_nfse_event(path: Path, expected_namespace: str) -> dict[str, Any]:\n",
    "    root = ET.parse(path).getroot()\n",
    "    if local_name(root.tag) != \"evento\":\n",
    "        raise ValueError(f\"{path.name}: raiz esperada evento\")\n",
    "    if not root.tag.startswith(f\"{{{expected_namespace}}}\"):\n",
    "        raise ValueError(f\"{path.name}: namespace inesperado\")\n",
    "    if root.attrib.get(\"versao\") != SUPPORTED_NFSE_VERSION:\n",
    "        raise ValueError(f\"{path.name}: versão não suportada\")\n",
    "\n",
    "    ns = {\"n\": expected_namespace}\n",
    "    inf = root.find(\"n:infEvento\", ns)\n",
    "    ped = root.find(\"n:infEvento/n:pedRegEvento/n:infPedReg\", ns)\n",
    "    if inf is None or ped is None:\n",
    "        raise ValueError(f\"{path.name}: infEvento/infPedReg ausente\")\n",
    "\n",
    "    event_node = next(\n",
    "        (child for child in list(ped) if local_name(child.tag).startswith(\"e\")),\n",
    "        None,\n",
    "    )\n",
    "    if event_node is None:\n",
    "        raise ValueError(f\"{path.name}: tipo de evento não encontrado\")\n",
    "\n",
    "    event_code = local_name(event_node.tag)[1:]\n",
    "    if event_code != SUPPORTED_CANCEL_EVENT:\n",
    "        raise ValueError(f\"{path.name}: evento {event_code} não suportado pela POC\")\n",
    "\n",
    "    return {\n",
    "        \"source_event_file\": path.name,\n",
    "        \"event_code\": event_code,\n",
    "        \"event_id\": inf.attrib.get(\"Id\"),\n",
    "        \"nfse_key\": xml_text(ped, \"n:chNFSe\", ns),\n",
    "        \"event_datetime\": xml_text(ped, \"n:dhEvento\", ns),\n",
    "        \"event_author_cnpj\": xml_text(ped, \"n:CNPJAutor\", ns),\n",
    "        \"event_reason_code\": xml_text(event_node, \"n:cMotivo\", ns),\n",
    "        \"event_reason\": xml_text(event_node, \"n:xMotivo\", ns),\n",
    "    }\n",
    "\n",
    "company_cnpj = fixture[\"fixture\"][\"company_cnpj\"]\n",
    "\n",
    "nfse_documents = []\n",
    "for file_name, cfg in nfse_document_configs.items():\n",
    "    row = parse_nfse_document(nfse_dir / file_name, NFSE_NAMESPACE, company_cnpj)\n",
    "    if row[\"direction\"] != cfg[\"expected_role\"]:\n",
    "        raise AssertionError(\n",
    "            f\"{file_name}: direção derivada={row['direction']} != esperada={cfg['expected_role']}\"\n",
    "        )\n",
    "    nfse_documents.append(row)\n",
    "\n",
    "nfse_events = [\n",
    "    parse_nfse_event(nfse_dir / file_name, NFSE_NAMESPACE)\n",
    "    for file_name in nfse_event_configs\n",
    "]\n",
    "\n",
    "silver_nfse_documents = pd.DataFrame(nfse_documents)\n",
    "silver_nfse_events = pd.DataFrame(nfse_events)\n",
    "\n",
    "cancelled_keys = set(\n",
    "    silver_nfse_events.loc[\n",
    "        silver_nfse_events[\"event_code\"] == SUPPORTED_CANCEL_EVENT,\n",
    "        \"nfse_key\",\n",
    "    ]\n",
    ")\n",
    "silver_nfse_documents[\"lifecycle_status\"] = silver_nfse_documents[\"nfse_key\"].map(\n",
    "    lambda key: \"CANCELLED\" if key in cancelled_keys else \"ACTIVE\"\n",
    ")\n",
    "\n",
    "assert len(silver_nfse_documents) == 5\n",
    "assert len(silver_nfse_events) == 1\n",
    "assert (silver_nfse_documents[\"lifecycle_status\"] == \"CANCELLED\").sum() == 1\n",
    "assert silver_nfse_documents.loc[\n",
    "    silver_nfse_documents[\"lifecycle_status\"] == \"CANCELLED\",\n",
    "    \"nfse_number\",\n",
    "].iloc[0] == \"1003\"\n",
    "\n",
    "print(silver_nfse_documents[\n",
    "    [\"source_nfse_file\", \"nfse_number\", \"direction\", \"lifecycle_status\", \"service_value\"]\n",
    "].to_string(index=False))"
   ]
  },
