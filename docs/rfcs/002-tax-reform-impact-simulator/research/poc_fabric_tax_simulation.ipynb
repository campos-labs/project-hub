    "## 4. Reconciliação EFD ↔ NFS-e e classificação RTC\n",
    "\n",
    "A EFD é a fonte observada de PIS/Cofins. A NFS-e é a fonte documental do serviço e do ISS.\n",
    "\n",
    "Para documentos ativos, a reconciliação usa `A100.CHV_NFSE == infNFSe/@Id` sem o prefixo `NFS`. O A100 cancelado 1003 permanece sem chave e é reconciliado apenas por `NUM_DOC`, com status explícito `NUM_DOC_CANCELLED_FALLBACK`.\n",
    "\n",
    "A classificação RTC prefere os campos declarados no XML (`cIndOp`, `cClassTrib`) quando presentes. No fornecedor Simples 2026 esses campos não existem; nesse caso usamos `service_item + NBS` apenas para obter tratamento quando todos os candidatos têm o mesmo CST/cClassTrib/reduções. A ambiguidade de `cIndOp` permanece registrada."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "dd518afb",
   "metadata": {},
   "outputs": [],
   "source": [
    "def norm_digits(value: str | None) -> str:\n",
    "    return re.sub(r\"\\D\", \"\", value or \"\")\n",
    "\n",
    "def service_item_from_ctrib(ctrib: str) -> str:\n",
    "    digits = norm_digits(ctrib)\n",
    "    if len(digits) < 4:\n",
    "        raise ValueError(f\"cTribNac inválido: {ctrib}\")\n",
    "    return f\"{digits[:2]}.{digits[2:4]}\"\n",
    "\n",
    "rtc_rules = pd.read_csv(\n",
    "    rtc_path,\n",
    "    sep=\";\",\n",
    "    dtype=str,\n",
    "    encoding=\"utf-8-sig\",\n",
    ").fillna(\"\")\n",
    "rtc_rules[\"nbs_norm\"] = rtc_rules[\"nbs_code\"].map(norm_digits)\n",
    "\n",
    "def classify_rtc(row: pd.Series) -> dict[str, Any]:\n",
    "    service_item = service_item_from_ctrib(row[\"ctrib_nacional\"])\n",
    "    nbs_norm = norm_digits(row[\"nbs\"])\n",
    "\n",
    "    candidates = rtc_rules[\n",
    "        (rtc_rules[\"service_item\"] == service_item)\n",
    "        & (rtc_rules[\"nbs_norm\"] == nbs_norm)\n",
    "    ].copy()\n",
    "\n",
    "    if candidates.empty:\n",
    "        return {\n",
    "            \"service_item\": service_item,\n",
    "            \"classification_status\": \"INSUFFICIENT_DATA\",\n",
    "            \"rule_candidate_count\": 0,\n",
    "            \"rule_cindop\": None,\n",
    "            \"rule_cst\": None,\n",
    "            \"rule_cclasstrib\": None,\n",
    "            \"ibs_reduction_pct\": None,\n",
    "            \"cbs_reduction_pct\": None,\n",
    "        }\n",
    "\n",
    "    declared_cindop = row.get(\"source_cindop\")\n",
    "    declared_cclass = row.get(\"source_cclasstrib\")\n",
    "\n",
    "    if declared_cindop:\n",
    "        narrowed = candidates[candidates[\"cindop\"] == declared_cindop]\n",
    "        if narrowed.empty:\n",
    "            raise AssertionError(\n",
    "                f\"{row['source_nfse_file']}: cIndOp {declared_cindop} não existe no \"\n",
    "                \"mapeamento service_item+NBS.\"\n",
    "            )\n",
    "        candidates = narrowed\n",
    "\n",
    "    if declared_cclass:\n",
    "        narrowed = candidates[candidates[\"cclasstrib\"] == declared_cclass]\n",
    "        if narrowed.empty:\n",
    "            raise AssertionError(\n",
    "                f\"{row['source_nfse_file']}: cClassTrib {declared_cclass} diverge do mapeamento.\"\n",
    "            )\n",
    "        candidates = narrowed\n",
    "\n",
    "    treatment_cols = [\n",
    "        \"cst\",\n",
    "        \"cclasstrib\",\n",
    "        \"ibs_reduction_pct\",\n",
    "        \"cbs_reduction_pct\",\n",
    "    ]\n",
    "    unique_treatments = candidates[treatment_cols].drop_duplicates()\n",
    "\n",
    "    if len(unique_treatments) != 1:\n",
    "        return {\n",
    "            \"service_item\": service_item,\n",
    "            \"classification_status\": \"INSUFFICIENT_DATA\",\n",
    "            \"rule_candidate_count\": len(candidates),\n",
    "            \"rule_cindop\": declared_cindop,\n",
    "            \"rule_cst\": None,\n",
    "            \"rule_cclasstrib\": None,\n",
    "            \"ibs_reduction_pct\": None,\n",
    "            \"cbs_reduction_pct\": None,\n",
    "        }\n",
    "\n",
    "    treatment = unique_treatments.iloc[0]\n",
    "    if len(candidates) == 1:\n",
    "        status = \"MATCHED\"\n",
    "        rule_cindop = candidates.iloc[0][\"cindop\"]\n",
    "    else:\n",
    "        status = \"AMBIGUOUS_OPERATION_INDICATOR_TREATMENT_EQUIVALENT\"\n",
    "        rule_cindop = declared_cindop or None\n",
    "\n",
    "    return {\n",
    "        \"service_item\": service_item,\n",
    "        \"classification_status\": status,\n",
    "        \"rule_candidate_count\": len(candidates),\n",
    "        \"rule_cindop\": rule_cindop,\n",
    "        \"rule_cst\": treatment[\"cst\"],\n",
    "        \"rule_cclasstrib\": treatment[\"cclasstrib\"],\n",
    "        \"ibs_reduction_pct\": Decimal(treatment[\"ibs_reduction_pct\"] or \"0\"),\n",
    "        \"cbs_reduction_pct\": Decimal(treatment[\"cbs_reduction_pct\"] or \"0\"),\n",
    "    }\n",
    "\n",
    "# Índice de itens A170 por pai A100. A fixture tem exatamente um item por documento ativo.\n",
    "items_by_parent = {\n",
    "    parent: group.iloc[0]\n",
    "    for parent, group in silver_efd_items.groupby(\"parent_record_id\")\n",
    "}\n",
    "\n",
    "efd_by_key = {\n",
    "    row[\"CHV_NFSE\"]: row\n",
    "    for _, row in silver_efd_documents.iterrows()\n",
    "    if row.get(\"CHV_NFSE\")\n",
    "}\n",
    "\n",
    "operations = []\n",
    "source_trace_rows = []\n",
    "\n",
    "for _, nfse in silver_nfse_documents.iterrows():\n",
    "    efd_row = efd_by_key.get(nfse[\"nfse_key\"])\n",
    "    reconciliation_method = \"CHV_NFSE\"\n",
    "\n",
    "    if efd_row is None and nfse[\"lifecycle_status\"] == \"CANCELLED\":\n",
    "        fallback = silver_efd_documents[\n",
    "            (silver_efd_documents[\"NUM_DOC\"] == nfse[\"nfse_number\"])\n",
    "            & (silver_efd_documents[\"COD_SIT\"] == \"02\")\n",
    "        ]\n",
    "        if len(fallback) != 1:\n",
    "            raise AssertionError(\n",
    "                f\"{nfse['source_nfse_file']}: fallback cancelado não é único.\"\n",
    "            )\n",
    "        efd_row = fallback.iloc[0]\n",
    "        reconciliation_method = \"NUM_DOC_CANCELLED_FALLBACK\"\n",
    "\n",
    "    if efd_row is None:\n",
    "        raise AssertionError(f\"{nfse['source_nfse_file']}: sem A100 correspondente.\")\n",
    "\n",
    "    expected_direction = \"REVENUE\" if efd_row[\"IND_OPER\"] == \"1\" else \"PURCHASE\"\n",
    "    if expected_direction != nfse[\"direction\"]:\n",
    "        raise AssertionError(\n",
    "            f\"{nfse['source_nfse_file']}: direção EFD={expected_direction} \"\n",
    "            f\"!= NFS-e={nfse['direction']}\"\n",
    "        )\n",
    "\n",
    "    active = nfse[\"lifecycle_status\"] == \"ACTIVE\"\n",
    "    efd_item = items_by_parent.get(efd_row[\"record_id\"])\n",
    "\n",
    "    if active:\n",
    "        if efd_row[\"VL_DOC\"] != nfse[\"service_value\"]:\n",
    "            raise AssertionError(f\"{nfse['source_nfse_file']}: VL_DOC != vServ.\")\n",
    "        if efd_item is None:\n",
    "            raise AssertionError(f\"{nfse['source_nfse_file']}: A170 ausente.\")\n",
    "        if efd_item[\"VL_ITEM\"] != nfse[\"service_value\"]:\n",
    "            raise AssertionError(f\"{nfse['source_nfse_file']}: VL_ITEM != vServ.\")\n",
    "\n",
    "        # PIS/Cofins do XML são controle quando presentes; a fonte analítica continua sendo EFD.\n",
    "        xml_pis = nfse[\"source_pis_value\"] or Decimal(\"0\")\n",
    "        xml_cofins = nfse[\"source_cofins_value\"] or Decimal(\"0\")\n",
    "        if efd_row[\"VL_PIS\"] != xml_pis or efd_row[\"VL_COFINS\"] != xml_cofins:\n",
    "            raise AssertionError(f\"{nfse['source_nfse_file']}: PIS/Cofins divergem da EFD.\")\n",
    "\n",
    "        if (efd_row[\"VL_ISS\"] or Decimal(\"0\")) != nfse[\"source_iss_value\"]:\n",
    "            raise AssertionError(f\"{nfse['source_nfse_file']}: ISS diverge da EFD.\")\n",
    "\n",
    "    classification = classify_rtc(nfse)\n",
    "\n",
    "    event_row = silver_nfse_events[\n",
    "        silver_nfse_events[\"nfse_key\"] == nfse[\"nfse_key\"]\n",
    "    ]\n",
    "    event_file = None if event_row.empty else event_row.iloc[0][\"source_event_file\"]\n",
    "\n",
    "    operation = {\n",
    "        \"efd_record_id\": efd_row[\"record_id\"],\n",
    "        \"efd_source_line\": efd_row[\"source_line\"],\n",
    "        \"reconciliation_method\": reconciliation_method,\n",
    "        **nfse.to_dict(),\n",
    "        **classification,\n",
    "        \"efd_cod_part\": efd_row[\"COD_PART\"],\n",
    "        \"efd_cod_sit\": efd_row[\"COD_SIT\"],\n",
    "        \"efd_pis_value\": efd_row[\"VL_PIS\"] or Decimal(\"0\"),\n",
    "        \"efd_cofins_value\": efd_row[\"VL_COFINS\"] or Decimal(\"0\"),\n",
    "        \"efd_iss_value\": efd_row[\"VL_ISS\"] or Decimal(\"0\"),\n",
    "        \"event_file\": event_file,\n",
    "    }\n",
    "    operations.append(operation)\n",
