    "## 1. Contrato, hashes e `SimulationRun`\n",
    "\n",
    "O `SimulationRun` é derivado de uma assinatura lógica dos inputs + versões do parser/cálculo + parâmetros. Um run concluído é imutável. `FORCE_RECOMPUTE=True` cria um novo identificador.\n",
    "\n",
    "O hash final da EFD **não é gravado no YAML**, porque a última correção foi manual. Ele é calculado aqui, no momento da execução. Os hashes das NFS-e e de `rtc_service_rules.csv` são verificados contra o contrato."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "aa13b032",
   "metadata": {},
   "outputs": [],
   "source": [
    "def sha256_file(path: Path) -> str:\n",
    "    h = hashlib.sha256()\n",
    "    with path.open(\"rb\") as fh:\n",
    "        for chunk in iter(lambda: fh.read(1024 * 1024), b\"\"):\n",
    "            h.update(chunk)\n",
    "    return h.hexdigest()\n",
    "\n",
    "def canonical_hash(payload: Any) -> str:\n",
    "    raw = json.dumps(\n",
    "        payload,\n",
    "        sort_keys=True,\n",
    "        ensure_ascii=False,\n",
    "        default=str,\n",
    "        separators=(\",\", \":\"),\n",
    "    ).encode(\"utf-8\")\n",
    "    return hashlib.sha256(raw).hexdigest()\n",
    "\n",
    "def git_commit_or_fallback() -> str:\n",
    "    for env_name in (\"GITHUB_SHA\", \"GIT_COMMIT\", \"BUILD_SOURCEVERSION\"):\n",
    "        value = os.getenv(env_name)\n",
    "        if value:\n",
    "            return value\n",
    "    try:\n",
    "        return subprocess.check_output(\n",
    "            [\"git\", \"rev-parse\", \"HEAD\"],\n",
    "            cwd=Path.cwd(),\n",
    "            text=True,\n",
    "            stderr=subprocess.DEVNULL,\n",
    "        ).strip()\n",
    "    except Exception:\n",
    "        return \"UNVERSIONED_RESEARCH\"\n",
    "\n",
    "fixture_path = DATA_DIR / \"simulation_fixture.yml\"\n",
    "layout_path = DATA_DIR / \"sped_layout_fields.csv\"\n",
    "\n",
    "fixture = yaml.safe_load(fixture_path.read_text(encoding=\"utf-8\"))\n",
    "\n",
    "assert fixture[\"fixture\"][\"scope\"][\"estimation_only\"] is True\n",
    "assert fixture[\"fixture\"][\"company_cnpj\"] == \"99999999000191\"\n",
    "assert fixture[\"sources\"][\"nfse_nacional\"][\"source_format\"] == \"NFSE_NACIONAL_XML\"\n",
    "assert fixture[\"sources\"][\"nfse_nacional\"][\"schema_version\"] == SUPPORTED_NFSE_VERSION\n",
    "assert fixture[\"sources\"][\"nfse_nacional\"][\"namespace\"] == NFSE_NAMESPACE\n",
    "assert fixture[\"sources\"][\"nfse_nacional\"][\"cancellation_event_code\"] == SUPPORTED_CANCEL_EVENT\n",
    "\n",
    "source_rows: list[dict[str, Any]] = []\n",
    "\n",
    "def register_source(\n",
    "    path: Path,\n",
    "    role: str,\n",
    "    expected_sha256: str | None = None,\n",
    ") -> str:\n",
    "    if not path.exists():\n",
    "        raise FileNotFoundError(path)\n",
    "    actual = sha256_file(path)\n",
    "    matches = None if expected_sha256 is None else actual == expected_sha256\n",
    "    if matches is False:\n",
    "        raise AssertionError(\n",
    "            f\"Hash divergente para {path.name}: esperado={expected_sha256}, atual={actual}. \"\n",
    "            \"Não altere a fixture automaticamente; confirme qual arquivo é o canônico.\"\n",
    "        )\n",
    "    source_rows.append({\n",
    "        \"source_file\": path.name,\n",
    "        \"source_path\": str(path),\n",
    "        \"source_role\": role,\n",
    "        \"sha256\": actual,\n",
    "        \"expected_sha256\": expected_sha256,\n",
    "        \"hash_matches_expected\": matches,\n",
    "        \"bytes\": path.stat().st_size,\n",
    "    })\n",
    "    return actual\n",
    "\n",
    "fixture_sha = register_source(fixture_path, \"scenario_contract\")\n",
    "layout_sha = register_source(layout_path, \"sped_layout_catalog\")\n",
    "\n",
    "rtc_cfg = fixture[\"sources\"][\"rtc_service_rules\"]\n",
    "rtc_path = DATA_DIR / rtc_cfg[\"file\"]\n",
    "rtc_sha = register_source(\n",
    "    rtc_path,\n",
    "    rtc_cfg[\"role\"],\n",
    "    rtc_cfg.get(\"sha256\"),\n",
    ")\n",
    "\n",
    "efd_cfg = fixture[\"sources\"][\"efd_contribuicoes\"]\n",
    "efd_path = DATA_DIR / efd_cfg[\"file\"]\n",
    "efd_sha = register_source(efd_path, efd_cfg[\"role\"])\n",
    "\n",
    "nfse_cfg = fixture[\"sources\"][\"nfse_nacional\"]\n",
    "nfse_dir = DATA_DIR / nfse_cfg[\"path\"]\n",
    "\n",
    "nfse_document_configs = {row[\"file\"]: row for row in nfse_cfg[\"documents\"]}\n",
    "nfse_event_configs = {row[\"file\"]: row for row in nfse_cfg[\"events\"]}\n",
    "\n",
    "for row in nfse_cfg[\"documents\"]:\n",
    "    register_source(\n",
    "        nfse_dir / row[\"file\"],\n",
    "        f\"nfse_document_{row['expected_role'].lower()}\",\n",
    "        row[\"sha256\"],\n",
    "    )\n",
    "for row in nfse_cfg[\"events\"]:\n",
    "    register_source(\n",
    "        nfse_dir / row[\"file\"],\n",
    "        f\"nfse_event_{row['event_code']}\",\n",
    "        row[\"sha256\"],\n",
    "    )\n",
    "\n",
    "bronze_file_manifest = pd.DataFrame(source_rows)\n",
    "\n",
    "scenario_parameters_hash = canonical_hash({\n",
    "    \"scenarios\": fixture[\"scenarios\"],\n",
    "    \"supplier_scenarios\": fixture[\"supplier_scenarios\"],\n",
    "    \"calculation\": fixture[\"calculation\"],\n",
    "    \"cash_flow\": fixture[\"cash_flow\"],\n",
    "})\n",
    "input_manifest_hash = canonical_hash(\n",
    "    bronze_file_manifest[[\"source_file\", \"sha256\"]]\n",
    "    .sort_values(\"source_file\")\n",
    "    .to_dict(\"records\")\n",
    ")\n",
    "\n",
    "run_signature_payload = {\n",
    "    \"fixture_id\": fixture[\"fixture\"][\"id\"],\n",
    "    \"fixture_version\": fixture[\"fixture\"][\"version\"],\n",
    "    \"input_manifest_hash\": input_manifest_hash,\n",
    "    \"sped_layout_sha256\": layout_sha,\n",
    "    \"rtc_mapping_sha256\": rtc_sha,\n",
    "    \"scenario_parameters_hash\": scenario_parameters_hash,\n",
    "    \"parser_version\": POC_CODE_VERSION,\n",
    "    \"calculation_engine_version\": POC_CODE_VERSION,\n",
    "    \"code_commit\": git_commit_or_fallback(),\n",
    "}\n",
    "\n",
    "if FORCE_RECOMPUTE:\n",
    "    run_signature_payload[\"force_nonce_utc\"] = datetime.now(timezone.utc).isoformat()\n",
    "\n",
    "simulation_run_hash = canonical_hash(run_signature_payload)\n",
    "simulation_run_id = f\"simrun_{simulation_run_hash[:20]}\"\n",
    "\n",
    "bronze_file_manifest.insert(0, \"simulation_run_id\", simulation_run_id)\n",
    "\n",
    "print(f\"simulation_run_id={simulation_run_id}\")\n",
    "print(f\"input_manifest_hash={input_manifest_hash}\")\n",
    "print(f\"scenario_parameters_hash={scenario_parameters_hash}\")\n",
    "display(bronze_file_manifest if \"display\" in globals() else bronze_file_manifest)"
   ]
